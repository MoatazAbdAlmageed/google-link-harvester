{
  "manifest_version": 3,
  "name": "Google Link Harvester",
  "version": "2.0",
  "description": "Collect all Google search result links from the first 5 pages in the background and copy them at once.",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": ["https://www.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png"
  }
}
